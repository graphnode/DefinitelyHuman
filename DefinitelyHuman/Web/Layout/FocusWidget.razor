@rendermode InteractiveServer
@using System.Globalization
@using DefinitelyHuman.Agent
@using DefinitelyHuman.Irc
@inject ChatAgent Agent
@inject IrcBot Bot
@implements IDisposable

<div class="focus-widget">
    <div class="focus-label">
        <span>Focus</span>
        <span class="focus-value">@_focus.ToString("F2")</span>
    </div>
    <div class="focus-bar" role="meter" aria-label="Focus" aria-valuemin="0" aria-valuemax="1"
         aria-valuenow="@_focus.ToString("F2", CultureInfo.InvariantCulture)" aria-valuetext="@($"{_focus:F2}, {Note}")">
        <div class="focus-bar-fill" style="width:@(Pct)%; background:@BarColor;"></div>
        @* Above this mark the bot treats the channel it last spoke in as a conversation it is in. *@
        <div class="focus-bar-mark" style="left:@((int)(ChatAgent.ActiveConversationFocus * 100))%"></div>
    </div>
    <div class="focus-note">@Note</div>
</div>
@* The dot only knows about our own link (to the server, or to a bouncer). Whether the channel
   is actually reaching us is shown as evidence instead: how long since a line last arrived. *@
<div class="sidebar-footer">
    <div><span class="status-dot @(_connected ? "online" : "offline")"></span>@(_connected ? "Linked to" : "No link to") @Bot.Endpoint</div>
    <div class="status-heard">@Heard</div>
</div>

@code {
    private double _focus;
    private (string Channel, DateTime At)? _nextGlance;
    private string? _conversation;
    private bool _connected;
    private DateTime? _lastLineAt;
    private Timer? _timer;

    // Focus decays continuously, so we poll rather than react to events.
    protected override void OnInitialized() => Poll();

    protected override void OnAfterRender(bool firstRender)
    {
        // OnAfterRender only runs once the component is interactive (not during prerender),
        // so the timer is created exactly once, in the live circuit.
        if (!firstRender)
            return;

        _timer = new Timer(_ =>
        {
            _ = InvokeAsync(() =>
            {
                Poll();
                StateHasChanged();
            });
        }, null, TimeSpan.FromSeconds(1), TimeSpan.FromSeconds(1));
    }

    private void Poll()
    {
        _focus = Agent.CurrentFocus;
        _nextGlance = Agent.NextGlance;
        _conversation = Agent.ConversationChannel;
        _connected = Bot.IsConnected;
        _lastLineAt = Bot.LastLineAt;
    }

    private string Heard
    {
        get
        {
            if (_lastLineAt is not { } at)
                return "no lines since start";

            var ago = DateTime.UtcNow - at;
            return ago < TimeSpan.FromMinutes(1) ? "last line just now"
                : ago < TimeSpan.FromHours(1) ? $"last line {(int)ago.TotalMinutes}m ago"
                : $"last line {(int)ago.TotalHours}h{ago.Minutes:00}m ago";
        }
    }

    private int Pct => (int)Math.Round(_focus * 100);

    private string BarColor => _focus switch
    {
        >= ChatAgent.ActiveConversationFocus => "var(--green)",   // active-conversation territory
        >= 0.15 => "var(--orange)", // noticing, but fading
        _ => "var(--text-muted)",   // basically not watching
    };

    // What the bar's colour means, in words; a scheduled glance takes over while it is pending.
    // Focus is shared by every channel, so the note says which one it is about.
    private string Note => _nextGlance is { } next
        ? $"glancing at {next.Channel} in {Math.Max(0, (int)Math.Ceiling((next.At - DateTime.UtcNow).TotalSeconds))}s"
        : _focus switch
        {
            >= ChatAgent.ActiveConversationFocus => _conversation is null ? "paying attention" : $"in conversation in {_conversation}",
            >= 0.15 => "fading",
            _ => "not watching",
        };

    public void Dispose() => _timer?.Dispose();
}
